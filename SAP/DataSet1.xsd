          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="FlujoVehicularSinExoneradoTableAdapter" GeneratorDataComponentClassName="FlujoVehicularSinExoneradoTableAdapter" Name="FlujoVehicularSinExonerado" UserDataComponentName="FlujoVehicularSinExoneradoTableAdapter">
